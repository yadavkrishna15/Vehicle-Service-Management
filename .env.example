# ==============================================================================
# Root Environment Variables Template for Vehicle Service Management System
# ==============================================================================

# Backend Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vsms?retryWrites=true&w=majority

# Backend Server Port
PORT=8080

# CORS Allowed Frontend URLs (comma-separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,https://your-vercel-app.vercel.app

# Frontend Client Base URL (set in frontend/js/api.js)
API_BASE_URL=http://localhost:8080
