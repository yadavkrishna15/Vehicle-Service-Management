# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster> with your Atlas details
MONGODB_URI=mongodb+srv://admin:password123@cluster0.mongodb.net/vsms?retryWrites=true&w=majority

# Port for Backend Server (default 8080)
PORT=8080

# Allowed Frontend URLs for CORS (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,https://your-vercel-app.vercel.app
